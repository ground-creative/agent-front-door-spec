{
  "note": "Documents that test the manifest rules. Three lists, because three obligations apply. 'cases' MUST be rejected by a conforming client (MAN-47, MAN-48) and are distinguishable after decoding. 'publisher' documents MUST NOT be emitted by a publisher, but a client either MUST accept them (MAN-53) or cannot distinguish them from a valid document after decoding a zero value, so they are schema checks only. 'accepted' documents a client MUST accept.",
  "cases": [
    {
      "name": "manifest-version-not-major-minor",
      "requirement": "MAN-1",
      "document": {
        "manifest_version": "1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": []
      }
    },
    {
      "name": "missing-endpoint",
      "requirement": "MAN-47",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "agents": []
      }
    },
    {
      "name": "endpoint-without-name",
      "requirement": "MAN-47",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "id": "x" },
        "agents": []
      }
    },
    {
      "name": "missing-agents",
      "requirement": "MAN-47",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" }
      }
    },
    {
      "name": "agent-without-name",
      "requirement": "MAN-47",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": [{ "description": "nameless", "sessions": true }]
      }
    },
    {
      "name": "agent-name-with-space",
      "requirement": "MAN-12",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": [{ "name": "order desk", "sessions": true }]
      }
    },
    {
      "name": "duplicate-agent-name",
      "requirement": "MAN-12",
      "note": "Semantic: JSON Schema cannot express cross-item uniqueness, but a decoder can.",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": [
          { "name": "a", "sessions": true },
          { "name": "a", "sessions": false }
        ]
      }
    },
    {
      "name": "duplicate-action-name",
      "requirement": "MAN-24",
      "note": "Semantic: JSON Schema cannot express uniqueness within one agent's actions, but a decoder can.",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": [
          {
            "name": "a",
            "sessions": false,
            "actions": [
              { "name": "place_order", "summary": "one" },
              { "name": "place_order", "summary": "two" }
            ]
          }
        ]
      }
    },
    {
      "name": "link-href-relative",
      "requirement": "MAN-19",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": [],
        "links": [{ "rel": "docs", "href": "/docs" }]
      }
    },
    {
      "name": "link-rel-uppercase",
      "requirement": "MAN-20",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": [],
        "links": [{ "rel": "Docs", "href": "https://example.com/docs" }]
      }
    },
    {
      "name": "action-name-uppercase",
      "requirement": "MAN-24",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": [
          {
            "name": "a",
            "sessions": false,
            "actions": [{ "name": "PlaceOrder", "summary": "x" }]
          }
        ]
      }
    },
    {
      "name": "capabilities-contradict-agents",
      "requirement": "MAN-29",
      "note": "Semantic, not structural: JSON Schema cannot express it, but a decoder can.",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "capabilities": {
          "session": { "new": false, "get": false, "close": false }
        },
        "agents": [{ "name": "a", "sessions": true }]
      }
    },
    {
      "name": "digest-not-sha256-prefixed",
      "requirement": "MAN-40",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": [],
        "digest": "6b1e9c1e8a6d4b2f5e7a0c3d9b8f6a4e2d1c0b9a8f7e6d5c4b3a2918f7e6d5c4"
      }
    }
  ],
  "publisher": [
    {
      "name": "publisher-omitted-manifest-version",
      "requirement": "MAN-1",
      "note": "A publisher MUST carry manifest_version. A client cannot reject its absence, because MAN-53 defines absence as manifest_version 1.0 and requires accepting it. Checkable by schema only.",
      "document": {
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": []
      }
    },
    {
      "name": "publisher-agent-without-sessions",
      "requirement": "MAN-47",
      "note": "A publisher MUST emit sessions. After decoding, an absent boolean is indistinguishable from false in most languages, so a client cannot enforce it. Checkable by schema only.",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": [{ "name": "a", "description": "no sessions flag" }]
      }
    },
    {
      "name": "publisher-session-ttl-zero",
      "requirement": "MAN-37",
      "note": "A publisher MUST emit a positive ttl_seconds. After decoding, 0 and absent are the same value. Checkable by schema only.",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": [],
        "session": { "ttl_seconds": 0 }
      }
    }
  ],
  "accepted": [
    {
      "name": "legacy-1.0-manifest-without-manifest-version",
      "requirement": "MAN-53",
      "schema": "manifest-1.0.schema.json",
      "note": "Absence of manifest_version MUST be read as 1.0, not rejected. Validate this one against the 1.0 schema, not the 1.1 schema.",
      "document": {
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "commands": ["session.new", "session.close"],
        "agents": [{ "name": "a", "sessions": true, "refs": { "docs": "https://example.com/docs" } }],
        "refs": { "site": "https://example.com" },
        "session": { "ttl_seconds": 3600, "list_enabled": true }
      }
    },
    {
      "name": "empty-agents-is-valid",
      "requirement": "MAN-7",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": []
      }
    },
    {
      "name": "unknown-members-are-ignored",
      "requirement": "MAN-3",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x", "future_field": { "nested": true } },
        "agents": [{ "name": "a", "sessions": false, "unknown_thing": 1 }],
        "something_new": ["a", "b"]
      }
    },
    {
      "name": "refs-alias-to-links",
      "requirement": "MAN-44",
      "document": {
        "manifest_version": "1.1",
        "protocol": "vireo/1",
        "endpoint": { "name": "x" },
        "agents": [],
        "refs": { "menu": "https://example.com/menu", "docs": "https://example.com/docs" }
      }
    }
  ]
}
