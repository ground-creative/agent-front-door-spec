{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-front-door.org/schema/manifest-1.0.json",
  "title": "Agent Front Door manifest, manifest_version 1.0",
  "description": "The pre-1.1 shape, kept checkable because MAN-53 requires a client to accept it: a manifest with no manifest_version is 1.0, and carries refs and commands instead of links and capabilities. A publisher SHOULD emit 1.1; this schema exists so the legacy form can still be validated.",
  "type": "object",
  "required": ["protocol", "endpoint", "agents"],
  "additionalProperties": true,
  "properties": {
    "protocol": { "type": "string", "minLength": 1 },
    "endpoint": { "$ref": "#/$defs/endpoint" },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/$defs/agent" }
    },
    "refs": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["session.new", "session.get", "session.list", "session.close", "session.prune"]
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ttl_seconds": { "type": "integer", "minimum": 1 },
        "list_enabled": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "agent": {
      "type": "object",
      "required": ["name", "sessions"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "sessions": { "type": "boolean" },
        "start_message": { "type": "string" },
        "refs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
